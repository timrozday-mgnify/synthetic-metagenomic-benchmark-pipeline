params {
    // Required
    input            = null   // samplesheet (YAML list of sample maps)
    outdir           = './results'

    // Run mode: 'all' (generate + profile) | 'generate' | 'profile'
    step             = 'all'

    // Publishing
    publish_dir_mode = 'copy'
    // Ground-truth BAMs omit read SEQ/QUAL (written as '*'). Truth tables only
    // need read names + reference, so this shrinks every BAM ~10-1000x. Set
    // false to keep full SEQ/QUAL alignments.
    slim_bam         = true

    // Taxonomic profiling ------------------------------------------------------
    // Extra profilers run against the SAME generated reads, on top of each sample's
    // primary `profiler`. Per-sample override via the samplesheet `extra_profilers`
    // column (or a top-level `extra_profilers:` key); a list, or comma-separated on
    // the CLI (--extra_profilers sr_shotgun,sylph). Every profiler writes its own
    // profile into that sample's benchmark dir, so one run compares several methods.
    extra_profilers  = []
    // sylph (WGS): named databases, mapseq_databases-style. Each entry needs a
    // prebuilt .syldb. The reserved value 'self' builds the DB from the sample's
    // own reference genomes (exact-match benchmark). Select per-sample via the
    // `database` samplesheet column.
    //   sylph_databases = [ gtdb_r220: [ syldb: '/dbs/gtdb.syldb', label: 'GTDB-r220' ] ]
    sylph_databases  = [:]

    // amplicon-analysis-pipeline (amplicon): run via nested `nextflow run`.
    aap_revision     = 'main'    // -r for ebi-metagenomics/amplicon-analysis-pipeline
    aap_profile      = null      // optional -profile for the nested run; null => omit (set the engine via aap_configs)
    aap_config       = null      // extra -c config (carries mapseq_databases etc.)
    // Ordered extra -c config files forwarded to every nested AAP run (engine/site config, etc.).
    // Accepts a list, or a comma-separated string on the CLI (--aap_configs a.config,b.config).
    aap_configs      = []
    // Optional PIMENTO custom primer library (directory of <region>_primers.fasta) forwarded
    // to the nested aap run as --std_primer_library. null => aap uses PIMENTO's bundled library.
    aap_std_primer_library = null

    // superresolution (sub-species composition by Bayesian inversion of a
    // mis-mapping matrix): two sibling pipelines sharing one interface, run via a
    // nested `nextflow run` and selected per-sample by `profiler: sr_amplicon|sr_shotgun`.
    // Their reference FASTA is built from the sample's genomes (`database: self`) or
    // from a named `databases:` collection — there is no external prebuilt DB.
    // A local checkout works in the same slot: --sr_shotgun_repo /path/to/checkout.
    sr_amplicon_repo = 'timrozday-mgnify/superresolution-amplicon'
    sr_shotgun_repo  = 'timrozday-mgnify/superresolution-shotgun'
    sr_revision      = 'main'    // -r for both nested runs (ignored for a local path)
    sr_profile       = null      // optional -profile for the nested run; null => omit
    // Ordered extra -c config files forwarded to every nested superresolution run
    // (engine/site config, inference tuning). List, or comma-separated on the CLI.
    sr_configs       = []
    // Presence/absence gate controls. null leaves the nested pipeline's modality-
    // specific defaults intact (amplicon: temp 1.0; shotgun: temp 2.0). Set these
    // independently to sweep the sparsity regulariser without a shared `-c` file.
    // The prior is the probability a reference genome is present; lower values make
    // false-positive calls harder. The temperature controls the relaxed Bernoulli
    // gate and should normally be >= 1. These options are unsupported with NUTS.
    sr_amplicon_infer_presence       = null
    sr_amplicon_infer_presence_prior = null
    sr_amplicon_infer_presence_temp  = null
    sr_shotgun_infer_presence        = null
    sr_shotgun_infer_presence_prior  = null
    sr_shotgun_infer_presence_temp   = null

    // Reproducibility
    seed             = 42

    // Split num_reads across N parallel generate-reads calls, merged after
    // (skipped when 1). Per-sample override via samplesheet `chunks` column.
    chunks           = 1

    // Read geometry (per-sample overridable via samplesheet columns of the same name)
    paired_end           = true    // legacy default was mode=paired
    read_length_mean     = 150     // genome-blender default
    read_length_variance = 10      // genome-blender default

    // Error-model training
    // Candidate component strings fitted by skiver; the min-AIC model is kept.
    error_model_candidates = 'AdditiveContext(5),AdditiveContext(7),AdditiveContext(9)'
    // Override: force a single component string (skips AIC selection over candidates).
    error_model_components = null

    // In-silico PCR (amplicon extraction). Samples with a `primers` column get one
    // AmpliconHunter `run` per primer pair, batched over their genomes. These args
    // are forwarded to `ampliconhunter run` (mismatches, amplicon length bounds).
    ampliconhunter_args = '--mismatches 2 --Lmin 50 --Lmax 2000'

    // Container image tags (images built + pushed by .github/workflows/build-images.yml)
    smb_skiver_tag         = 'latest'
    smb_genome_blender_tag = 'latest'
    smb_ampliconhunter_tag = 'latest'

    // Resource limits (overridden by HPC/cloud profiles)
    max_cpus         = 16
    max_memory       = '128.GB'
    max_time         = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}

manifest {
    name            = 'synthetic-metagenomic-benchmark-pipeline'
    description     = 'Train a sequencing error profile from natural metagenomes and generate synthetic metagenomes with ground-truth mapping + profile'
    version         = '0.1.0'
    nextflowVersion = '>=25.0'
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    overwrite = false
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

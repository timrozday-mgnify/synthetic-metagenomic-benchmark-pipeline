nextflow_pipeline {
    name "Test Pipeline SYNTHETIC_METAGENOMIC_BENCHMARK"
    script "main.nf"

    tag "pipeline"

    test("two synthetic samples - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/test.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 2 samples share train_id natA -> train once. S1 fans out over
                // 2 subsample runs (none + 500), S2 over 1 (none). So:
                // 1 SEQKIT_SUBSAMPLE_TRAIN + 1 SKIVER_DUMP + 1 SKIVER_TRAIN + 1 SKIVER_REPORT
                // + 2 NORMALISE_REFERENCES + 2 GENOME_BLENDER_GENERATE + 3 SEQKIT_SUBSAMPLE + 3 GROUND_TRUTH = 14
                { assert workflow.trace.succeeded().size() == 14 }
            )
        }
    }

    test("chunked generation - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/chunks.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // S1 with chunks:3, no subsample: 1 subsample_train + 1 dump + 1 train + 1 report
                // + 1 NORMALISE_REFERENCES + 3 GENOME_BLENDER_GENERATE + 1 MERGE_GENOME_BLENDER_CHUNKS
                // + 1 SEQKIT_SUBSAMPLE + 1 GROUND_TRUTH = 11
                { assert workflow.trace.succeeded().size() == 11 },
                { assert path("${params.outdir}/S1/S1_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/S1.truth.tsv").exists() }
            )
        }
    }

    test("generate + sylph self profiling - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/profiling.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 12 generation tasks (subsample_train + dump + train + report
                // + 2 NORMALISE_REFERENCES + 2 gen + 2 subsample + 2 truth)
                // + per sample: SYLPH_BUILD_DB + SYLPH_PROFILE + NORMALIZE_SYLPH
                // = 3*2 = 6 profiling tasks = 18.
                { assert workflow.trace.succeeded().size() == 18 },
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.sylph_profile.tsv").exists() }
            )
        }
    }

    test("built + prebuilt profiler databases - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/databases.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Built DBs published under databases/<name>/ (the prebuilt-dir layout).
                { assert path("${params.outdir}/databases/commA/commA.syldb").exists() },
                { assert path("${params.outdir}/databases/ampA/ampA.mapseq.fasta").exists() },
                { assert path("${params.outdir}/databases/ampA/ampA.mapseq.tax").exists() },
                { assert path("${params.outdir}/databases/ampA/ampA.mapseq.otu").exists() },

                // S1 profiled against the built sylph DB; S3 against the pre-built dir.
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/S3/S3.sylph_profile.tsv").exists() },

                // S2 profiled via aap against the built mapseq DB.
                { assert path("${params.outdir}/S2/profiling/aap").exists() }
            )
        }
    }

    test("superresolution profiling - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/superresolution.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Collection references published in the prebuilt-dir layout. Only the
                // genome source is built: no sample references srA with sr_amplicon.
                { assert path("${params.outdir}/databases/srA/srA_genome.sr_refs.fasta").exists() },

                // Normalised profile next to truth.tsv for all four: self/shotgun,
                // self/amplicon, and the two samples sharing the named collection.
                { assert path("${params.outdir}/S1/S1.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S3/S3.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S4/S4.sr_profile.tsv").exists() },

                // Raw composition CSV kept under profiling/sr/.
                { assert path("${params.outdir}/S1/profiling/sr/S1.inferred_composition.csv").exists() },

                // sr_amplicon's own mapseq classification lands beside it, so a
                // re-profiling run can hand it back as `mseq:`. sr_shotgun has none.
                { assert path("${params.outdir}/S2/profiling/sr/S2.obs.mseq.gz").exists() },
                { assert !path("${params.outdir}/S1/profiling/sr/S1.obs.mseq.gz").exists() },

                // A reusable matrix is published per reference set, rather than once
                // inside every sample's profiling directory.
                { assert path("${params.outdir}/mismapping/self_S1_sr_shotgun/mismapping_matrix.csv").exists() },
                { assert path("${params.outdir}/mismapping/self_S2_sr_amplicon/mismapping_matrix.npz").exists() },
                { assert path("${params.outdir}/mismapping/srA_sr_shotgun/mismapping_matrix.csv").exists() },
                { assert !path("${params.outdir}/S1/profiling/sr/S1.mismapping_matrix.csv").exists() },
                { assert !path("${params.outdir}/S2/profiling/sr/S2.mismapping_matrix.npz").exists() },

                // Reads are generated once per SAMPLE, not per sample x profiler (S1 fans
                // out to sr_shotgun + sylph). Asserted here as well as in the e2e test:
                // e2e only runs on main, so a samplesheet gaining a sample used to drift
                // this count and not be caught until after merge.
                { assert workflow.trace.succeeded().findAll { it.name.contains("GENOME_BLENDER_GENERATE") }.size() == 4 },

                // Only the 'self' samples build their own references (S1, S2); S3 and S4
                // share the collection's. One matrix build AND one batched inference run
                // per reference set — S3 and S4 go into srA's single nested run together.
                { assert workflow.trace.succeeded().findAll { it.name.contains("BUILD_SUPERRESOLUTION_MISMAPPING") }.size() == 3 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("RUN_SUPERRESOLUTION") }.size() == 3 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("SR_BUILD_REFS") }.size() == 2 },
                // ...and that batch really is one task holding both samples.
                { assert workflow.trace.succeeded().findAll {
                      it.name.contains("RUN_SUPERRESOLUTION") && it.name.contains("srA") }.size() == 1 },

                // S1 also lists sylph in profilers: same reads, second profile.
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").exists() }
            )
        }
    }

    test("sr_settings fan-out and a supplied mseq - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/sr_settings.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            def sheet = path("${params.outdir}/S2/profiling/sr/S2.fast.nested_samplesheet.yml").text
            def provenance = path("${params.outdir}/mismapping").list()
                .collect { path("${it}/mismapping_provenance.json").text }
            assertAll(
                { assert workflow.success },

                // One profile per setting, all in the source sample's benchmark dir.
                { assert path("${params.outdir}/S2/S2.fast.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.fast_strict.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.simulated.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.kmer_fixed.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.kmer_latent.sr_profile.tsv").exists() },

                // fast + fast_strict differ only in the inference knobs, so they share a
                // reference set and its matrix; so do kmer_fixed + kmer_latent, which
                // differ only in whether the distance decay is fitted. `simulated`
                // changes the matrix mode and gets its own. Three matrices, five
                // inference runs.
                { assert workflow.trace.succeeded().findAll { it.name.contains("BUILD_SUPERRESOLUTION_MISMAPPING") }.size() == 3 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("RUN_SUPERRESOLUTION") }.size() == 5 },
                { assert path("${params.outdir}/mismapping").list().size() == 3 },

                // The knobs really reach the matrix builds, differently.
                { assert provenance.any { it.contains("--align_backend exact-hash") } },
                { assert provenance.any { it.contains("--mismapping_method simulate") } },
                { assert provenance.any { it.contains("--align_distance_decay 0.007") } },

                // The nested pipeline refuses --infer_distance_decay unless its own
                // --mismapping_method/--align_tau say align at tau >= 1, even with a
                // supplied matrix, so the latent inference run repeats the matrix mode.
                // The fixed one doesn't need it and keeps its old command line.
                { assert path("${params.outdir}/S2/profiling/sr/S2.kmer_latent.nested_args.txt").text
                      .contains("--mismapping_method align --align_backend kmer --align_tau 1") },
                { assert !path("${params.outdir}/S2/profiling/sr/S2.kmer_fixed.nested_args.txt").text
                      .contains("--mismapping_method") },

                // The supplied classification is in the nested samplesheet, so the nested
                // run skips its own mapping — and therefore publishes none of its own.
                { assert sheet.contains("mseq: ") && sheet.contains("S2.obs.mseq.gz") },
                { assert !path("${params.outdir}/S2/profiling/sr/S2.fast.obs.mseq.gz").exists() }
            )
        }
    }

    test("sr_settings fan-out - stub") {
        tag "stub"
        options "-stub"
        // Stub twin of the e2e "sr_settings fan-out" test below, over the same
        // samplesheet. It guards that test's task counts and output paths on every PR —
        // e2e runs only on main, and a count that drifts there is not caught until after
        // merge (which is exactly how the GENOME_BLENDER_GENERATE count went stale).
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/sr_settings_e2e.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert path("${params.outdir}/E1/E1.align.p01.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/E1/E1.align.p001.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/E1/E1.sim.p01.sr_profile.tsv").exists() },
                { assert workflow.trace.succeeded().findAll { it.name.contains("BUILD_SUPERRESOLUTION_MISMAPPING") }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("RUN_SUPERRESOLUTION") }.size() == 3 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("GENOME_BLENDER_GENERATE") }.size() == 1 },
                { assert path("${params.outdir}/mismapping").list().size() == 2 },
                // No sample supplies `mseq:`, so each run publishes its own classification.
                { assert path("${params.outdir}/E1/profiling/sr/E1.align.p01.obs.mseq.gz").exists() }
            )
        }
    }

    test("mis-mapping mode reaches the nested matrix build - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/superresolution.yaml"
                outdir = "$outputDir"
                sr_amplicon_mismapping_method = "align"
                sr_amplicon_align_backend     = "kmer"
                sr_amplicon_align_tau         = 1
                sr_amplicon_matrix_args       = "--align_ambiguity_weight 0.3"
                sr_shotgun_matrix_args        = "--sim_n_per_chunk 25"
            }
        }
        then {
            def amplicon = path("${params.outdir}/mismapping/self_S2_sr_amplicon/mismapping_provenance.json").text
            def shotgun  = path("${params.outdir}/mismapping/self_S1_sr_shotgun/mismapping_provenance.json").text
            assertAll(
                { assert workflow.success },
                // Every amplicon knob, named and free-form, on the build command line.
                { assert amplicon.contains("--mismapping_method align") },
                { assert amplicon.contains("--align_backend kmer") },
                { assert amplicon.contains("--align_tau 1") },
                { assert amplicon.contains("--align_ambiguity_weight 0.3") },
                // The shotgun sibling has different knobs and must not inherit these.
                { assert shotgun.contains("--sim_n_per_chunk 25") },
                { assert !shotgun.contains("align_backend") }
            )
        }
    }

    test("profilers - several profilers over one set of reads - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/multi_profiler.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Reads generated ONCE per sample...
                { assert workflow.trace.succeeded().findAll { it.name.contains("GENOME_BLENDER_GENERATE") }.size() == 3 },

                // ...but profiled by every listed profiler, each
                // dropping its own profile next to that sample's truth.tsv.
                { assert path("${params.outdir}/E1/E1.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/E1/E1.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/E2/E2.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/E2/E2.sr_profile.tsv").exists() },
                { assert path("${params.outdir}/E3/profiling/aap/E3").exists() },
                { assert path("${params.outdir}/E3/E3.sr_profile.tsv").exists() },

                // A collection referenced by two profilers builds both DB kinds.
                { assert path("${params.outdir}/databases/commA/commA.syldb").exists() },
                { assert path("${params.outdir}/databases/commA/commA_genome.sr_refs.fasta").exists() },
                { assert path("${params.outdir}/databases/ampA/ampA.mapseq.otu").exists() },
                { assert path("${params.outdir}/databases/ampA/ampA_ssu.sr_refs.fasta").exists() },

                // E2 is database:self and fans out to sylph + sr_shotgun — the `combine`
                // (not `join`) against ch_aux is what keeps both alive.
                { assert workflow.trace.succeeded().findAll { it.name.contains("SR_BUILD_REFS") }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("SYLPH_BUILD_DB") }.size() == 1 }
            )
        }
    }

    test("train-only - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/train.yaml"
                outdir = "$outputDir"
                step   = "train"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // train-only: 1 SEQKIT_SUBSAMPLE_TRAIN + 1 SKIVER_DUMP + 1 SKIVER_TRAIN
                // + 1 SKIVER_REPORT = 4. No generation/profiling.
                { assert workflow.trace.succeeded().size() == 4 },
                { assert path("${params.outdir}/error_models/natA/natA.model.pt").exists() }
            )
        }
    }

    test("generate with pre-trained error_model_dir - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/pretrained.yaml"
                outdir = "$outputDir"
                step   = "generate"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // No training for natA (model comes from error_model_dir):
                // 1 NORMALISE_REFERENCES + 1 GENOME_BLENDER_GENERATE + 1 SEQKIT_SUBSAMPLE + 1 GROUND_TRUTH = 4.
                { assert workflow.trace.succeeded().size() == 4 },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER_TRAIN') } },
                { assert path("${params.outdir}/S1/S1_R1.fastq.gz").exists() }
            )
        }
    }

    test("profile-only aap - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/profile.yaml"
                outdir = "$outputDir"
                step   = "profile"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // profile-only: no generation, just 1 RUN_AAP.
                { assert workflow.trace.succeeded().size() == 1 }
            )
        }
    }

    test("profile-only aap batching - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/profile_aap_batch.yaml"
                outdir = "$outputDir"
                step   = "profile"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // A1+A2 share a DB config -> 1 batched RUN_AAP; A3's differs -> 1 more. 2 total.
                { assert workflow.trace.succeeded().size() == 2 },
                { assert workflow.trace.tasks().findAll { it.name.contains('RUN_AAP') }.size() == 2 },
                // Every sample still publishes under its own dir despite batching.
                { assert path("${params.outdir}/A1/profiling/aap").exists() },
                { assert path("${params.outdir}/A2/profiling/aap").exists() },
                { assert path("${params.outdir}/A3/profiling/aap").exists() }
            )
        }
    }

    test("two synthetic samples") {
        tag "e2e"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/test.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Reads (paired) per sample
                { assert path("${params.outdir}/S1/S1_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/S1_R2.fastq.gz").exists() },
                { assert path("${params.outdir}/S2/S2_R1.fastq.gz").exists() },

                // S1's 500-read subsample gets its own dir with its own reads + truth
                { assert path("${params.outdir}/S1/subsample_500/S1_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/subsample_500/S1.sub500.truth.tsv").exists() },

                // Ground-truth BAM + index
                { assert path("${params.outdir}/S1/S1.sorted.bam").exists() },
                { assert path("${params.outdir}/S1/S1.sorted.bam.bai").exists() },

                // Ground-truth profile with both genomes + 4 columns
                { assert path("${params.outdir}/S1/S1.truth.tsv").exists() },
                { assert path("${params.outdir}/S1/S1.truth.tsv").text.contains("genomeA") },
                { assert path("${params.outdir}/S1/S1.truth.tsv").text.contains("genomeB") },
                { assert path("${params.outdir}/S1/S1.truth.tsv").readLines().get(0)
                    == "genome_id\ttarget_rel_abundance\trealized_n_reads\trealized_rel_abundance" },

                // Trained model shared by both samples (train once)
                { assert path("${params.outdir}/error_models/natA/natA.model.pt").exists() },
                { assert path("${params.outdir}/error_models/natA/natA.phred_calibration.json").exists() },
                { assert path("${params.outdir}/error_models/natA/natA.error_model_report.html").exists() },

                // train_subsample: 1000 -> training reads published at 1000 reads (4000 lines), not the full 6000
                { assert path("${params.outdir}/error_models/natA/training_reads/natural_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/error_models/natA/training_reads/natural_R1.fastq.gz").linesGzip.size() == 4000 }
            )
        }
    }

    test("chunked generation - unique read ids + cat merge") {
        tag "e2e"
        // Real (non-stub) chunked run: S1 fans out over 3 chunks, each with a
        // distinct --read-prefix, then MERGE_GENOME_BLENDER_CHUNKS concatenates
        // the per-chunk BAMs with `samtools cat`. Verifies the read-name
        // uniqueness fix (no colliding IDs once chunks are merged) and that the
        // cat-merged BAM is valid (GROUND_TRUTH sorts + indexes it downstream).
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/chunks.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            // Read IDs from the merged R1 FASTQ (concatenation of all 3 chunks).
            def headers = path("${params.outdir}/S1/S1_R1.fastq.gz").linesGzip
                .withIndex().findAll { line, i -> i % 4 == 0 }.collect { line, i -> line }
            def ids = headers.collect { it.split(/\s/)[0] }          // up to first space
            def prefixes = ids.collect { it.replaceFirst(/^@/, '').split(':')[0] }

            assertAll(
                { assert workflow.success },

                // Merged reads + cat-merged, sorted, indexed ground-truth BAM.
                { assert path("${params.outdir}/S1/S1_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/S1_R2.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/S1.sorted.bam").exists() },
                { assert path("${params.outdir}/S1/S1.sorted.bam.bai").exists() },
                { assert path("${params.outdir}/S1/S1.truth.tsv").exists() },

                // Core fix: no colliding read IDs across the merged chunks.
                { assert ids.size() > 0 },
                { assert (ids as Set).size() == ids.size() },

                // --read-prefix wiring: every read is namespaced by its chunk,
                // and reads actually came from more than one chunk.
                { assert prefixes.every { it.startsWith('S1.chunk') } },
                { assert (prefixes as Set).size() >= 2 }
            )
        }
    }

    test("generate + sylph self profiling") {
        tag "e2e"
        when {
            params {
                input  = "${projectDir}/tests/samplesheets/profiling.yaml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Generation + ground truth still produced.
                { assert path("${params.outdir}/S1/S1_R1.fastq.gz").exists() },
                { assert path("${params.outdir}/S1/S1.truth.tsv").exists() },

                // Predicted sylph profile lands next to truth.tsv, with the right header.
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/S2/S2.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" },

                // Raw sylph output kept under profiling/.
                { assert path("${params.outdir}/S1/profiling/sylph/S1.sylph.tsv").exists() }
            )
        }
    }

    test("superresolution profiling") {
        tag "e2e"
        // Launches both nested superresolution pipelines for real. They're pulled
        // from GitHub on first run (params.sr_*_repo / sr_revision), so this needs
        // network access plus their GHCR images; tests/sr_fast.config scales the
        // inference down to the fixture size, and the nested run needs its own
        // -profile (it doesn't inherit the outer one).
        when {
            params {
                input      = "${projectDir}/tests/samplesheets/superresolution.yaml"
                outdir     = "$outputDir"
                sr_profile = "docker"
                sr_configs = [ "${projectDir}/tests/sr_fast.config" ]
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // Generation + ground truth still produced.
                { assert path("${params.outdir}/S1/S1.truth.tsv").exists() },

                // Same truth-comparable contract sylph emits, for both flavours.
                { assert path("${params.outdir}/S1/S1.sr_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" },
                { assert path("${params.outdir}/S2/S2.sr_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" },
                { assert path("${params.outdir}/S3/S3.sr_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" },

                // Genomes are the community's, and the abundances renormalise to 1.
                { assert path("${params.outdir}/S1/S1.sr_profile.tsv").readLines().size() > 1 },
                { assert Math.abs(path("${params.outdir}/S1/S1.sr_profile.tsv").readLines()
                    .drop(1).collect { it.split("\t")[1] as double }.sum() - 1.0) < 1e-5 },
                { assert path("${params.outdir}/S1/S1.sr_profile.tsv").readLines().drop(1)
                    .collect { it.split("\t")[0] }.every { it in ["genomeA", "genomeB"] } },

                // Raw composition CSV kept under profiling/sr/.
                { assert path("${params.outdir}/S1/profiling/sr/S1.inferred_composition.csv").exists() },

                // Fan-out for real: S1's reads are generated once and profiled
                // by both sr_shotgun and sylph, each publishing into the same dir.
                // One generate per SAMPLE (S1-S4), not per sample x profiler.
                { assert workflow.trace.succeeded().findAll { it.name.contains("GENOME_BLENDER_GENERATE") }.size() == 4 },
                { assert path("${params.outdir}/S1/S1.sylph_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" },
                { assert path("${params.outdir}/S1/profiling/sylph/S1.sylph.tsv").exists() }
            )
        }
    }

    test("sr_settings fan-out") {
        tag "e2e"
        // The fan-out for real: one set of reads, three superresolution-amplicon
        // settings, two of which share a mis-mapping matrix. Everything here is checked
        // by the stub test too, except the only things a stub cannot check — that the
        // nested pipeline accepts these flag combinations, that two genuinely different
        // matrix modes both produce a usable matrix, and that each setting's inference
        // yields a real profile rather than the same one three times.
        when {
            params {
                input      = "${projectDir}/tests/samplesheets/sr_settings_e2e.yaml"
                outdir     = "$outputDir"
                sr_profile = "docker"
                sr_configs = [ "${projectDir}/tests/sr_fast.config" ]
            }
        }
        then {
            def profiles = ["align.p01", "align.p001", "sim.p01"].collect {
                path("${params.outdir}/E1/E1.${it}.sr_profile.tsv")
            }
            assertAll(
                { assert workflow.success },

                // One profile per setting, all beside the one truth they are scored against.
                { assert path("${params.outdir}/E1/E1.truth.tsv").exists() },
                { assert profiles.every { it.exists() } },
                { assert profiles.every { p -> p.readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" } },

                // Real inference, not an empty contract: the community's genomes, and
                // abundances that renormalise to 1.
                { assert profiles.every { p -> p.readLines().size() > 1 } },
                { assert profiles.every { p -> p.readLines().drop(1)
                    .collect { it.split("\t")[0] }.every { it in ["genomeA", "genomeB"] } } },
                { assert profiles.every { p -> Math.abs(p.readLines().drop(1)
                    .collect { it.split("\t")[1] as double }.sum() - 1.0) < 1e-5 } },

                // The cost story: three settings, but the two agreeing on every matrix
                // knob share a reference set and so build ONE matrix between them.
                { assert workflow.trace.succeeded().findAll { it.name.contains("BUILD_SUPERRESOLUTION_MISMAPPING") }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("RUN_SUPERRESOLUTION") }.size() == 3 },
                { assert workflow.trace.succeeded().findAll { it.name.contains("GENOME_BLENDER_GENERATE") }.size() == 1 },

                // Each matrix records the mode it was actually built in, so a swept point
                // is attributable. Both modes must appear, or the settings collapsed.
                { assert path("${params.outdir}/mismapping").list().size() == 2 },
                { assert path("${params.outdir}/mismapping").list()
                    .collect { path("${it}/mismapping_provenance.json").text }
                    .any { it.contains("\"mismapping_method\": \"align\"") } },
                { assert path("${params.outdir}/mismapping").list()
                    .collect { path("${it}/mismapping_provenance.json").text }
                    .any { it.contains("\"mismapping_method\": \"simulate\"") } },

                // The classification a sweep would feed back as `mseq:` is published for
                // each setting's run, since none of them was given one.
                { assert path("${params.outdir}/E1/profiling/sr/E1.align.p01.obs.mseq.gz").exists() }
            )
        }
    }

    test("profile-only sylph, configured db") {
        tag "e2e"
        // Uses a committed .syldb fixture (tests/data/refdb.syldb, built with
        // `sylph sketch -g genomeA.fasta genomeB.fasta -o refdb`) as a configured
        // (non-self) database, exercising the step=profile + params.sylph_databases path.
        when {
            params {
                input           = "${projectDir}/tests/samplesheets/profile_sylph.yaml"
                outdir          = "$outputDir"
                step            = "profile"
                sylph_databases = [ refdb: [ syldb: "${projectDir}/tests/data/refdb.syldb", label: "refdb" ] ]
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert path("${params.outdir}/P1/P1.sylph_profile.tsv").exists() },
                { assert path("${params.outdir}/P1/P1.sylph_profile.tsv").readLines().get(0)
                    == "genome_id\tpredicted_rel_abundance\tpredicted_tax_rel_abundance" }
            )
        }
    }
}

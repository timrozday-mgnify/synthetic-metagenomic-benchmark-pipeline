// Tuning forwarded (as an extra `-c`) to the nested superresolution runs so the
// e2e test finishes in minutes on the tiny fixtures instead of hours. Both
// pipelines are launched by RUN_SUPERRESOLUTION with --sr_configs pointing here.
//
// The nested run does NOT inherit the outer -profile either; set --sr_profile docker
// alongside this file.
process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    // Inference: the default 3000 SVI steps dominate runtime on a 2-genome fixture.
    infer_steps     = 200

    // Mis-mapping simulation: fewer simulated reads per chunk/reference.
    sim_n_per_chunk = 50   // shotgun
    sim_n_per_ref   = 50   // amplicon

    // Shotgun chunking: the fixture genomes are far smaller than the 10 kb default.
    chunk_len       = 4000

    // Only used when --sim_error_model is a trained skiver model (default is 'flat',
    // which skips training entirely). Harmless otherwise.
    error_model_components = 'AdditiveContext(3)'
    skiver_dump_args       = '-c 1'
}

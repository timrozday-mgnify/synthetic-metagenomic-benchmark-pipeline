process {
    // 125: xargs child killed by signal (e.g. OOM kill of a wrapped command)
    // 137: SIGKILL (128+9), direct OOM kill
    errorStrategy = { task.exitStatus in [125, 130, 137, 140, 143, 104, 175] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    withLabel: 'process_single' {
        cpus   = { 1 }
        memory = { 6.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // The nested-pipeline launchers supervise an entire nested run, so their wall clock
    // is that pipeline's, not one tool's — process_single's 4h SIGTERMs (exit 143) a big
    // AAP batch or a long superresolution run mid-flight. Give them the run's ceiling
    // (resourceLimits caps everything at params.max_time anyway).
    withName: 'RUN_AAP|BUILD_SUPERRESOLUTION_MISMAPPING|RUN_SUPERRESOLUTION' {
        time = { params.max_time }
    }
}

// Overrides for the SILVA superresolution-amplicon parameter sweep.
//
// The sr_amplicon_* matrix knobs ARE set here, unlike examples/sr_amplicon_param_sweep,
// and only for phase 1's benefit: that run has no `sr_settings:` to fan out over, so it
// would otherwise profile at the nested pipeline's default (`simulate`), which builds a
// matrix by simulating and mapping reads for every reference in the set. Fine for a
// 20-genome collection; not fine for SILVA. Pinning them to the grid's `exact` point
// gives phase 1 an affordable baseline.
//
// Phase 2 ignores all of them: a knob set both here and in a grid point takes the grid
// point's value.
params {
    seed = 42

    sr_amplicon_mismapping_method = 'align'
    sr_amplicon_align_backend     = 'exact-hash'
    sr_amplicon_align_tau         = 0
    sr_amplicon_matrix_args       = '--align_ambiguity_weight 0.3'

    sr_amplicon_infer_presence       = true
    sr_amplicon_infer_presence_prior = 0.01
    sr_amplicon_infer_presence_temp  = 1.0

    // Both phases infer in V4-group space: a SILVA reference is one rRNA sequence, so
    // genome space means nothing against it. Unlike the knobs above this one is NOT
    // overridden in phase 2, because no grid point sets `inference_args`. A point that
    // does replaces it, and must repeat the flag.
    sr_amplicon_inference_args = '--infer_space v4_group'

    // The superresolution pipelines are nested `nextflow run`s and do NOT inherit the
    // outer -profile.
    sr_profile = 'docker'
    // PINNED: upstream main migrated to panel-only kernels and now rejects
    // `--mismapping_matrix`, the flag this pipeline reuses one measured matrix with.
    // This is the last commit before that migration (47336629), plus the two SILVA
    // fixes cherry-picked onto it (branch `silva-fixes-pinned`): an RNA reference
    // alphabet folded to DNA, and batched amplicon extraction. Move it on once
    // upstream P.4 lands a panel-kernel input.
    sr_revision = 'd448dfad0429075f57f8f82a49ee931b3557771c'
    // sr_configs  = ['/path/to/sr_singularity.config']  // engine config on HPC
    // sr_amplicon_repo = '/path/to/superresolution-amplicon'  // a local checkout works too

    // 2x300 amplicon: force a single context model instead of the AIC search if you prefer:
    // error_model_components = 'AdditiveContext(7)'
}

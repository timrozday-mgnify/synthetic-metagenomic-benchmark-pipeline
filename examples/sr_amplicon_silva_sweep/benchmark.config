// Overrides for the SILVA superresolution-amplicon parameter sweep.
//
// No sr_amplicon_* kernel knob is set here. Phase 1's mapping setting and phase 2's grid
// both come from row-level `sr_settings:` in the generated samplesheets, and a knob
// pinned here would leak into every entry that leaves it out.
params {
    seed = 42

    // The superresolution pipelines are nested `nextflow run`s and do NOT inherit the
    // outer -profile.
    sr_profile = 'docker'
    // PINNED to superresolution-amplicon#30's merge: panel-only inference (P.4-P.7) with
    // --panel_kernel reuse, the panel-side IUPAC pass that builds an align kernel against
    // SILVA in seconds rather than ~1 h (#28), and an --amplicon_cache that concurrent
    // cold kernel builds can share (#30). It maps
    // against the reference FASTA itself, so AAP's SILVA-SSU directory works unmodified.
    sr_revision = '0f43df74bcdfba49bb38f71eb4d22c7c3bf3ea0c'
    // sr_configs  = ['/path/to/sr_singularity.config']  // engine config on HPC
    // sr_amplicon_repo = '/path/to/superresolution-amplicon'  // a local checkout works too

    // 2x300 amplicon: force a single context model instead of the AIC search if you prefer:
    // error_model_components = 'AdditiveContext(7)'
}

// Overrides for the SILVA panel-reinterpretation vs custom-database sweep.
//
// No sr_amplicon_* knob is set here. Phase 1's mapping setting and both phase-2 grids
// come from row-level `sr_settings:` in the generated samplesheets. A knob pinned here
// would leak into every entry that leaves it out, e.g. a panel entry inheriting align flags.
params {
    seed = 42

    // The superresolution pipelines are nested `nextflow run`s and do NOT inherit the
    // outer -profile.
    sr_profile = 'docker'

    // PINNED to the superresolution-amplicon commit whose --panel_kernel input this
    // pipeline's kernel reuse was tested against (panel-only inference, P.4-P.7).
    sr_revision = 'b0f6d1e5ff6d9b0646b441ca443cacdf07f23296'
    // sr_amplicon_repo = '/path/to/superresolution-amplicon'  // a local checkout instead
    // sr_configs  = ['/path/to/sr_singularity.config']  // engine config on HPC

    // 2x300 amplicon: force a single context model instead of the AIC search if you prefer:
    // error_model_components = 'AdditiveContext(7)'
}

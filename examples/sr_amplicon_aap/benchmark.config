// Overrides for the Phase 4 truth-sample run. Every sr_amplicon knob comes from the
// samplesheet's sr_settings, so none is pinned here.
params {
    seed = 42

    // Nested runs don't inherit the outer -profile.
    sr_profile  = 'docker'
    aap_profile = 'docker'
    sr_configs  = ["${projectDir}/examples/sr_amplicon_aap/nested.config"]
    aap_configs = ["${projectDir}/examples/sr_amplicon_aap/nested.config"]

    // superresolution-amplicon with Phases 1-3 (upstream #22-#27), the panel-side IUPAC
    // pass for the align kernel (#28: ~1 h -> seconds against SILVA), and an
    // --amplicon_cache that concurrent cold kernel builds can share (#30).
    sr_revision  = '0f43df74bcdfba49bb38f71eb4d22c7c3bf3ea0c'
    // The AAP release whose fastp and MAPseq builds the plan measured.
    aap_revision = 'v6.1.5'
}

// AMPLICONHUNTER asks for 36 GB. Cap every task for a 24 GB machine (nested.config does
// the same for the nested runs); raise or drop it on a bigger host.
process.resourceLimits = [memory: 18.GB]

// SKIVER_REPORT's Quarto kernel times out under arm64 emulation (CLAUDE.md). The HTML
// report is a side branch; the model and calibration publish without it.
process { withName: 'SKIVER_REPORT' { errorStrategy = 'ignore' } }

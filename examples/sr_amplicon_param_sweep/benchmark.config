// Overrides for the superresolution-amplicon parameter sweep.
//
// Note what is NOT here: the sr_amplicon_* knobs. They are the run-global setting, one
// value for every sample, and this example sweeps them instead — from the samplesheet's
// `sr_settings:` block, which the generator scripts expand out of config.yaml's grid. A
// knob set in both places takes the samplesheet's value.
params {
    seed = 42

    // The superresolution pipelines are nested `nextflow run`s and do NOT inherit the
    // outer -profile.
    sr_profile = 'docker'
    // PINNED to superresolution-amplicon#28's merge: panel-only inference (P.4-P.7) with
    // --panel_kernel reuse, plus the panel-side IUPAC pass that builds an align kernel
    // against SILVA in seconds rather than ~1 h.
    sr_revision = '0c7d95d12774add8b8e4df679bb8a93d93ddb517'
    // sr_configs  = ['/path/to/sr_singularity.config']  // engine config on HPC
    // sr_amplicon_repo = '/path/to/superresolution-amplicon'  // a local checkout works too

    // 2x300 amplicon: force a single context model instead of the AIC search if you prefer:
    // error_model_components = 'AdditiveContext(7)'
}
